# --- Oturum ---
WABOT_SESSIONS=session
# Bot sahibinin numarası (ülke kodu ile, + olmadan). Boş bırakılırsa config.js içindeki değer kullanılır.
OWNER=
# Ekrana QR okutmak yerine 8 haneli bağlantı kodu almak için (ülke kodu hariç)
PAIRING_PHONE=
# Hata bildirimlerinin gönderileceği sohbet id'si (boşsa sadece loglanır)
LOG_CHAT_ID=

# --- Yapay zekâ (çoklu sağlayıcı havuzu) ---
# Sohbet komutları (.ai, .ceviri, .ozet, .resimai) bu havuzdan geçer.
# Her sağlayıcıya virgülle birden fazla anahtar verilebilir; anahtarlar
# döngüsel kullanılır, biri hata verirse sıradakine geçilir. Bir sağlayıcı
# tümden çalışmazsa otomatik olarak sıradaki sağlayıcıya geçilir.
#
# ÖNEMLİ: Anahtarı olmayan sağlayıcı havuza hiç alınmaz (boş yere denenmez).
# Gemini istisnadır: anahtar verilmese de ücretsiz katman çalışır.
#
# Sıra AI_ORDER ile belirlenir. Ölçülen hızlar (2026-09):
#   groq ~0.3sn · mistral ~0.6sn · openrouter ~1.4sn · gemini ~6sn
AI_ORDER=groq,mistral,gemini,openrouter,openai,anthropic

GROQ_KEYS=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

MISTRAL_KEYS=
MISTRAL_MODELS=ministral-8b-latest,ministral-3b-latest,mistral-medium-latest

GEMINI_KEYS=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest

OPENROUTER_KEYS=
# Ücretsiz model adlarının sonunda ":free" olmalı
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free

OPENAI_KEYS=
OPENAI_MODELS=gpt-4o-mini
ANTHROPIC_KEYS=
ANTHROPIC_MODELS=claude-sonnet-5

# Havuzun önüne ek yedek anahtar listesi (OpenAI uyumlu uç nokta varsayılır)
AI_API_KEYS=

# --- Görsel üretimi (.imagine) ---
# auto = OPENAI_API_KEY varsa önce OpenAI denenir, çalışmazsa anahtarsız
#        Pollinations'a düşülür. openai = yalnız OpenAI. pollinations = yalnız anahtarsız.
# Not: OpenAI hesabında kredi yoksa .imagine yalnızca Pollinations ile çalışır.
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1
POLLINATIONS_MODEL=flux

# --- Metinden sese (.tts) ---
# gtts (anahtarsız) | openai | elevenlabs
TTS_PROVIDER=gtts
TTS_LANG=tr
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# Yalnızca OpenAI uyumlu özel bir uç nokta (vekil sunucu vb.) kullanacaksan
# gerekir. Havuz dışında, görsel/ses üretimi tarafından okunur. Boş bırakılabilir.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Telegram sticker paketi (.telesticker için varsayılan) ---
TELEGRAM_STICKER_PACK=

# --- Otomatik medya indirme (.otoindir) ---
# Virgülle ayrılmış izinli alan adları
AUTODL_HOSTS=youtube.com,youtu.be,tiktok.com,instagram.com,facebook.com,fb.watch,x.com,twitter.com,threads.net,spotify.com,pinterest.com

# --- Haber kaynağı (.haber) ---
NEWS_FEEDS=https://feeds.bbci.co.uk/turkce/rss.xml

# --- Web paneli ---
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3080
DASHBOARD_API_KEY=

# --- Araçlar ---
YT_DLP_PATH=yt-dlp
OCR_SPACE_API_KEY=
REMOVEBG_API_KEY=
REMBG_MODEL=u2net
# REMBG_PYTHON: Python yolu. Boş bırakılırsa otomatik bulunur (Windows:
# %LOCALAPPDATA%\Python\bin\python.exe). rembg kurulu değilse:
#   pip install rembg[cpu]
REMBG_PYTHON=
# --- WEB ARAMASI: Tavily (virgülle ayrılmış anahtarlar round-robin kullanılır) ---
# Sıra: Tavily → Bing → Google → DuckDuckGo. Anahtar yoksa yine arama çalışır.
TAVILY_KEYS=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_SEARCH_API_KEY=
TENOR_API_KEY=
MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_TOKEN=
